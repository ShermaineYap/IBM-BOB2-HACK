      "results": [
        {
          "ruleId": "hardcoded-secret",
          "level": "error",
          "message": {
            "text": "JWT signing key hardcoded as literal string in config. The production JWT signing secret is committed directly in source code. An attacker with repository access can forge arbitrary session tokens and impersonate any user."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/config.js"
                },
                "region": {
                  "startLine": 6,
                  "snippet": {
                    "text": "  jwtSecret: 'shoply-prod-secret-2024-do-not-share',"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F01"
          },
          "properties": {
            "security-severity": "8.0",
            "asvs": "V6.4.1",
            "status": "fixed",
            "fixDiff": "audit/fixes/F01.diff"
          }
        },
        {
          "ruleId": "session-ttl",
          "level": "note",
          "message": {
            "text": "Session token lifetime set to 30 days. Tokens remain valid for 30 days with no refresh or revocation mechanism. A stolen token gives an attacker a month-long window of access."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/config.js"
                },
                "region": {
                  "startLine": 7,
                  "snippet": {
                    "text": "  tokenTtlSeconds: 60 * 60 * 24 * 30,"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F02"
          },
          "properties": {
            "security-severity": "2.0",
            "asvs": "V3.3.2",
            "status": "fixed",
            "fixDiff": "audit/fixes/F02.diff"
          }
        },
        {
          "ruleId": "weak-password-policy",
          "level": "warning",
          "message": {
            "text": "Password minimum length is only 6 characters. Passwords of 7 characters are accepted; the ASVS minimum is 12. Short passwords are easily cracked by brute force or dictionary attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/services/user.js"
                },
                "region": {
                  "startLine": 5,
                  "snippet": {
                    "text": "  return typeof password === 'string' && password.length > 6;"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F03"
          },
          "properties": {
            "security-severity": "5.0",
            "asvs": "V2.1.1",
            "status": "fixed",
            "fixDiff": "audit/fixes/F03.diff"
          }
        },
        {
          "ruleId": "weak-hashing",
          "level": "error",
          "message": {
            "text": "Passwords hashed with MD5 (unsalted). MD5 is cryptographically broken and produces no per-user salt. An attacker who obtains the database can crack all passwords in seconds using rainbow tables or GPU-accelerated hash attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/services/user.js"
                },
                "region": {
                  "startLine": 9,
                  "snippet": {
                    "text": "  return crypto.createHash('md5').update(password).digest('hex');"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F04"
          },
          "properties": {
            "security-severity": "8.0",
            "asvs": "V2.4.1",
            "status": "fixed",
            "fixDiff": "audit/fixes/F04.diff"
          }
        },
        {
          "ruleId": "sqli",
          "level": "error",
          "message": {
            "text": "SQL injection via string concatenation in searchByName. The caller-supplied search term is concatenated directly into SQL. An attacker can escape the LIKE clause and execute arbitrary SQL, extracting or modifying the entire database."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/services/user.js"
                },
                "region": {
                  "startLine": 29,
                  "snippet": {
                    "text": "  return all(\"SELECT id, email, display_name FROM users WHERE display_name LIKE '%\" + term + \"%'\");"
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F05"
          },
          "properties": {
            "security-severity": "8.0",
            "asvs": "V5.3.4",
            "status": "fixed",
            "fixDiff": "audit/fixes/F05.diff"
          }
        },
        {
          "ruleId": "sqli",
          "level": "error",
          "message": {
            "text": "SQL injection via string concatenation in login query. The email field from the request body is concatenated directly into SQL. An attacker can inject SQL to bypass authentication entirely and log in as any user."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/routes/auth.js"
                },
                "region": {
                  "startLine": 29,
                  "snippet": {
                    "text": "      \"SELECT * FROM users WHERE email = '\" + email + \"' AND password = '\" + hashed + \"'\""
                  }
                }
              }
            }
          ],
          "partialFingerprints": {
            "devpulseId": "audit:F06"
          },
          "properties": {
            "security-severity": "8.0",
            "asvs": "V5.3.4",
            "status": "fixed",
            "fixDiff": "audit/fixes/F06.diff"
          }
        },
        {
          "ruleId": "missing-rate-limit",
          "level": "warning",
          "message": {
            "text": "Login endpoint has no rate limiting or lockout. There is no throttle, lockout, or delay on POST /auth/login. An attacker can make unlimited password guessing attempts against any account."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "sample_app/routes/auth.js"
                },
                "region": {
                  "startLine": 24,
                  "snippet": {
                    "text": "authRouter.post('/login', async (req, res, next) => {"
                  }
                }
              }
            }
