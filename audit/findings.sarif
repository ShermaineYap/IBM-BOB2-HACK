        },
        {
          "ruleId": "missing-authz",
          "level": "error",
          "message": {
            "text": "Admin /users endpoint accessible with no authentication or role check. The GET /admin/users route returns all user records including admin flags without verifying a token or role. Any unauthenticated attacker can enumerate every account in the system."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
