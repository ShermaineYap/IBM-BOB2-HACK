          },
          "properties": {
            "security-severity": "5.0",
            "asvs": "V2.2.1",
            "status": "fixed",
            "fixDiff": "audit/fixes/F07.diff"
          }
        },
        {
          "ruleId": "xss",
          "level": "error",
          "message": {
            "text": "Reflected XSS: search term interpolated into HTML response. The req.query.q value is interpolated directly into an HTML response without encoding. An attacker can craft a URL that executes arbitrary JavaScript in a victim's browser, stealing session tokens or performing actions on their behalf."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
