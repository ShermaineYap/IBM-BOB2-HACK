{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevPulse audit findings",
  "type": "object",
  "required": [
    "run",
    "findings"
  ],
  "properties": {
    "run": {
      "type": "object",
      "required": [
        "tool",
        "mode",
        "date",
        "target"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "const": "IBM Bob 2.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "agent",
            "plan",
            "ask",
            "custom",
            "security-auditor"
          ]
        },
        "date": {
          "type": "string",
          "description": "ISO 8601"
        },
        "target": {
          "type": "string",
          "description": "path audited, e.g. sample_app/"
        },
        "subagents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_session_screenshot": {
          "type": "string",
          "description": "path under bob_sessions/"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "asvs",
          "severity",
          "file",
          "line",
          "title",
          "evidence",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2}$"
          },
          "category": {
            "type": "string",
            "enum": [
              "sqli",
              "xss",
              "command-injection",
              "path-traversal",
              "ssrf",
              "open-redirect",
              "prototype-pollution",
              "mass-assignment",
              "missing-authz",
              "broken-auth",
              "csrf",
              "cors-misconfig",
              "insecure-deserialization",
              "weak-password-policy",
              "weak-hashing",
              "weak-random",
              "insecure-compare",
              "hardcoded-secret",
              "missing-rate-limit",
              "info-leak",
              "session-ttl",
              "redos",
              "other"
            ]
          },
          "asvs": {
            "type": "string",
            "description": "OWASP ASVS 4.0 requirement id, e.g. V5.3.4"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "evidence": {
            "type": "string",
            "description": "the offending line(s), verbatim"
          },
          "explanation": {
            "type": "string",
            "description": "one or two sentences: why it is a problem and what an attacker could do"
          },
          "fix_diff": {
            "type": "string",
            "description": "path to a unified diff under audit/fixes/"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "fixed",
              "wont-fix"
            ],
            "default": "open"
          }
        }
      }
    }
  }
}
