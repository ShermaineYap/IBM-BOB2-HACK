          }
        },
        {
          "ruleId": "info-leak",
          "level": "warning",
          "message": {
            "text": "Request body (including passwords and tokens) written to server logs. Every request body is logged verbatim, including POST /password-reset (email) and PATCH /me (potentially new password). Anyone with log access can harvest credentials submitted by users."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
