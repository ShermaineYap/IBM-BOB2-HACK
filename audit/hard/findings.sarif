            "asvs": "V12.3.1",
            "status": "fixed",
            "fixDiff": "audit/hard/fixes/F08.diff"
          }
        },
        {
          "ruleId": "ssrf",
          "level": "error",
          "message": {
            "text": "SSRF in /webhooks/test, user-supplied URL fetched without allow-list. The URL comes from req.body.url with no allow-list or scheme restriction. An authenticated attacker can make the server probe internal services (e.g. http://169.254.169.254/latest/meta-data/) or arbitrary external endpoints."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ledger_app/routes/integrations.js"
                },
                "region": {
                  "startLine": 13,
                  "snippet": {
                    "text": "    const response = await fetch(target, { method: 'POST', body: JSON.stringify({ ping: true }) });"
