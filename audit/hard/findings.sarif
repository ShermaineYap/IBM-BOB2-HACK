          }
        },
        {
          "ruleId": "missing-authz",
          "level": "error",
          "message": {
            "text": "IDOR in GET /invoices/:id, no owner_id check. The query fetches any invoice by ID without verifying that it belongs to the requesting user. Any authenticated user can enumerate all invoices by iterating IDs, leaking all customer names and amounts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ledger_app/routes/invoices.js"
                },
                "region": {
                  "startLine": 24,
